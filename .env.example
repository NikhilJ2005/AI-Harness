# Copy this file to `.env` and fill in your key.
# VibeStack reads all configuration from environment variables; see
# vibestack/config.py for the full list.

# Required: your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Optional: override the model used for each routing tier.
# Model IDs use LiteLLM's OpenRouter naming: "openrouter/<provider>/<model>".
# These defaults are examples only — swap them for whatever you prefer.
CHEAP_MODEL=openrouter/deepseek/deepseek-chat
MID_MODEL=openrouter/openai/gpt-4o-mini
PREMIUM_MODEL=openrouter/anthropic/claude-3.5-sonnet

# Optional: how long to wait for a single model response, in seconds.
REQUEST_TIMEOUT_SECONDS=60
