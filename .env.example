# Copy this file to `.env` and fill in your key.
# See vibestack/config.py for the full list of settings.

# Required for prompts, repairs, and the review council. Generation from a
# specification file needs no key at all.
OPENROUTER_API_KEY=

# --- Models -----------------------------------------------------------------
# LiteLLM's OpenRouter form: openrouter/<provider>/<model>
#
# OpenRouter's free tier changes without notice. The free Qwen and Llama
# endpoints were withdrawn in August 2026, so check openrouter.ai/models before
# relying on any :free id, and run:
#
#     python scripts/model_preflight.py
#
# Note also that free-model requests are capped at 50/day for accounts holding
# under $10 of credit, and 1,000/day above it. One generation makes roughly 6-9
# requests (1 parse + 5 review + up to 3 repairs), so the lower cap allows only
# about six generations a day.
CHEAP_MODEL=openrouter/openai/gpt-oss-120b:free
MID_MODEL=openrouter/openai/gpt-oss-120b:free

# Repair is the hard reasoning step, and this is also where the fallback chain
# lands when a free endpoint disappears. Keep at least one paid model here.
PREMIUM_MODEL=openrouter/anthropic/claude-3.5-sonnet

# How to ask for structured output: tools | json | md_json
# "tools" is strongest but needs function calling. The client falls back through
# the others automatically, so this only sets which is tried first.
INSTRUCTOR_MODE=tools

REQUEST_TIMEOUT_SECONDS=60
