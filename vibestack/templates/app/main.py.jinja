"""FastAPI application entry point for {{ project_name }}."""

from fastapi import FastAPI

from app.database import Base, engine
from app.models import *  # noqa: F401,F403  (registers every model with Base)
{% for module in router_modules %}
from app.routers import {{ module }}
{% endfor %}

# Create any missing tables at start-up so the project runs immediately after
# generation. A production deployment would use Alembic migrations instead.
Base.metadata.create_all(bind=engine)

app = FastAPI(
    title="{{ project_title }}",
    description="{{ description }}",
    version="0.1.0",
)

{% for module in router_modules %}
app.include_router({{ module }}.router)
{% endfor %}


@app.get("/health", tags=["health"])
def health_check() -> dict[str, str]:
    """Report that the service is running, for container health checks."""
    return {"status": "ok"}
