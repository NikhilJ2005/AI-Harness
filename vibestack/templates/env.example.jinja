# Copy this file to `.env` and adjust the values for your environment.

# Database connection string. The default uses a local SQLite file so the
# project runs with no extra services; docker compose overrides it with Postgres.
DATABASE_URL=sqlite:///./{{ project_slug }}.db
{% if has_auth %}

# Secret used to sign access tokens. Replace this before deploying.
SECRET_KEY=change-me-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60
{% endif %}
