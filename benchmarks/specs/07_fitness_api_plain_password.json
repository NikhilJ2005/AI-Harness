{
  "project_name": "fitness_api",
  "description": "A workout tracker. Declares a clear-text 'password' field, which the planner must replace with a hashed column.",
  "entities": [
    {
      "name": "User",
      "fields": [
        { "name": "id", "type": "int", "primary_key": true, "nullable": false },
        { "name": "email", "type": "str", "unique": true, "nullable": false },
        { "name": "password", "type": "str", "nullable": false },
        { "name": "weight_kg", "type": "float", "nullable": true }
      ],
      "relationships": [
        { "target_entity": "Workout", "type": "one_to_many", "back_populates": "user" }
      ]
    },
    {
      "name": "Workout",
      "fields": [
        { "name": "id", "type": "int", "primary_key": true, "nullable": false },
        { "name": "name", "type": "str", "nullable": false },
        { "name": "duration_minutes", "type": "int", "nullable": false },
        { "name": "performed_at", "type": "datetime", "nullable": false }
      ],
      "relationships": []
    }
  ],
  "auth": { "enabled": true, "strategy": "jwt", "endpoints": ["register", "login", "me"] },
  "features": []
}
