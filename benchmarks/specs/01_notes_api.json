{
  "project_name": "notes_api",
  "description": "A minimal note-taking API with no authentication.",
  "entities": [
    {
      "name": "Note",
      "fields": [
        { "name": "id", "type": "int", "primary_key": true, "nullable": false },
        { "name": "title", "type": "str", "nullable": false },
        { "name": "body", "type": "text", "nullable": true },
        { "name": "pinned", "type": "bool", "nullable": false },
        { "name": "created_at", "type": "datetime", "nullable": false }
      ],
      "relationships": []
    }
  ],
  "auth": { "enabled": false, "strategy": "jwt", "endpoints": [] },
  "features": []
}
